---
interface Props {
  title?: string;
}

import '../styles/global.css';

const { title = "Redstone Workshop | Blueprint Catalog" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  </head>
  <body class="bg-[#090D16] text-slate-100 font-sans min-h-screen antialiased selection:bg-red-500/30 selection:text-red-200">
    <slot />
  </body>
</html>

<style is:global>
  /* Import Tailwind CSS */
  @import "tailwindcss";

  /* Custom Font Settings */
  .font-mono {
    font-family: 'JetBrains Mono', monospace;
    font-feature-settings: "tnum";
  }

  /* Custom Glow Utility Classes */
  .glow-red {
    box-shadow: 0 0 12px rgba(239, 68, 68, 0.35);
  }
  .glow-cyan {
    box-shadow: 0 0 12px rgba(6, 182, 212, 0.35);
  }
  .glow-amber {
    box-shadow: 0 0 12px rgba(245, 158, 11, 0.35);
  }
</style>