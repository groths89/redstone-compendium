---
interface Props {
  app?: 'workshop' | 'academy' | 'compendium';
  activePath?: string;
  blueprintCount?: number;
}

const { app = 'compendium', activePath = 'catalog', blueprintCount = 12 } = Astro.props;
---

<header class="border-b border-white/10 bg-[#0F172A]/80 backdrop-blur-md sticky top-0 z-50 px-6 py-4 flex items-center justify-between gap-6">
  
  <!-- Left Side: Brand / Title -->
  <div class="flex items-center gap-3 shrink-0">
    <div class="w-3 h-3 rounded-full bg-[#EF4444] glow-red animate-pulse"></div>
    <a href="/" class="text-xl font-bold tracking-tight text-white flex items-center gap-2 hover:opacity-90 transition-opacity">
      <span>REDSTONE {app.toUpperCase()}</span>
      <span class="text-xs font-mono font-normal px-2 py-0.5 rounded bg-slate-800 text-slate-400 border border-white/5">
        {app === 'workshop' ? 'CATALOG v1.0' : app === 'academy' ? 'STARTER GUIDE' : 'COMPENDIUM'}
      </span>
    </a>
  </div>

  <!-- Center: Dynamic In-Page Menu Links -->
  <nav class="hidden xl:flex items-center gap-1.5" data-active-classes="bg-surface-container-high text-on-surface rounded-xl">
    
    {app === 'compendium' && (
      <>
        <a aria-current={activePath === 'catalog' ? 'page' : undefined} class={`font-label-md px-3 py-1.5 transition-colors duration-150 rounded-xl ${activePath === 'catalog' ? 'bg-slate-800 text-white' : 'text-slate-400 hover:text-white hover:bg-slate-800/50'}`} data-path="catalog" href="#">Catalog</a>
        <a aria-current={activePath === 'interactive-explorer' ? 'page' : undefined} class={`font-label-md px-3 py-1.5 transition-colors duration-150 rounded-xl ${activePath === 'interactive-explorer' ? 'bg-slate-800 text-white' : 'text-slate-400 hover:text-white hover:bg-slate-800/50'}`} data-path="interactive-explorer" href="#">Interactive Explorer</a>
        <a aria-current={activePath === 'alu-and-architecture' ? 'page' : undefined} class={`font-label-md px-3 py-1.5 transition-colors duration-150 rounded-xl ${activePath === 'alu-and-architecture' ? 'bg-slate-800 text-white' : 'text-slate-400 hover:text-white hover:bg-slate-800/50'}`} data-path="alu-and-architecture" href="#">ALU & Architecture</a>
        <a aria-current={activePath === 'tick-timing-engine' ? 'page' : undefined} class={`font-label-md px-3 py-1.5 transition-colors duration-150 rounded-xl ${activePath === 'tick-timing-engine' ? 'bg-slate-800 text-white' : 'text-slate-400 hover:text-white hover:bg-slate-800/50'}`} data-path="tick-timing-engine" href="#">Tick Timing Engine</a>
        <a aria-current={activePath === 'design-system-and-specs' ? 'page' : undefined} class={`font-label-md px-3 py-1.5 transition-colors duration-150 rounded-xl ${activePath === 'design-system-and-specs' ? 'bg-slate-800 text-white' : 'text-slate-400 hover:text-white hover:bg-slate-800/50'}`} data-path="design-system-and-specs" href="#">Design System / Specs</a>
      </>
    )}

  {app === 'academy' && (
    <nav class="hidden xl:flex items-center gap-space-xs" data-active-classes="bg-surface-container-high text-on-surface rounded-xl">
      <a aria-current="page" class="font-label-md px-3 py-1.5 transition-colors duration-150 bg-surface-container-high text-on-surface rounded-xl flex items-center gap-1" data-path="catalog" href="#">
        <span class="material-symbols-outlined text-[16px] text-tertiary">school</span><span>Learning Path</span>
      </a>
      <a class="font-label-md text-label-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low px-3 py-1.5 rounded-xl transition-colors duration-150 flex items-center gap-1" data-path="interactive-explorer" href="#">
        <span class="material-symbols-outlined text-[16px]">touch_app</span><span>Interactive Playground</span>
      </a>
      <a class="font-label-md text-label-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low px-3 py-1.5 rounded-xl transition-colors duration-150" data-path="alu-and-architecture" href="#">Blueprint Vault</a>
      <a class="font-label-md text-label-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low px-3 py-1.5 rounded-xl transition-colors duration-150" data-path="tick-timing-engine" href="#">Timing Visualizer</a>
      <a class="font-label-md text-label-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low px-3 py-1.5 rounded-xl transition-colors duration-150" data-path="design-system-and-specs" href="#">Glossary &amp; Tips</a>
    </nav>
  )}

    {app === 'workshop' && (
      <>
        <a aria-current={activePath === 'catalog' ? 'page' : undefined} class={`font-label-md px-3 py-1.5 transition-colors duration-150 rounded-xl flex items-center gap-1.5 ${activePath === 'catalog' ? 'bg-slate-800 text-white border border-cyan-500/20' : 'text-slate-400 hover:text-white hover:bg-slate-800/50'}`} data-path="catalog" href="#">
          <span class="material-symbols-outlined text-cyan-400 text-[16px]">menu_book</span>Blueprint Catalog
        </a>
        <a aria-current={activePath === 'interactive-explorer' ? 'page' : undefined} class={`font-label-md px-3 py-1.5 transition-colors duration-150 rounded-xl flex items-center gap-1.5 ${activePath === 'interactive-explorer' ? 'bg-slate-800 text-white border border-cyan-500/20' : 'text-slate-400 hover:text-white hover:bg-slate-800/50'}`} data-path="interactive-explorer" href="#">
          <span class="material-symbols-outlined text-[16px]">view_in_ar</span>3D Sandbox
        </a>
        <a aria-current={activePath === 'alu-and-architecture' ? 'page' : undefined} class={`font-label-md px-3 py-1.5 transition-colors duration-150 rounded-xl flex items-center gap-1.5 ${activePath === 'alu-and-architecture' ? 'bg-slate-800 text-white border border-cyan-500/20' : 'text-slate-400 hover:text-white hover:bg-slate-800/50'}`} data-path="alu-and-architecture" href="#">
          <span class="material-symbols-outlined text-[16px]">build_circle</span>Survival Builds
        </a>
        <a aria-current={activePath === 'tick-timing-engine' ? 'page' : undefined} class={`font-label-md px-3 py-1.5 transition-colors duration-150 rounded-xl flex items-center gap-1.5 ${activePath === 'tick-timing-engine' ? 'bg-slate-800 text-white border border-cyan-500/20' : 'text-slate-400 hover:text-white hover:bg-slate-800/50'}`} data-path="tick-timing-engine" href="#">
          <span class="material-symbols-outlined text-[16px]">timer</span>Tick Clocks
        </a>
        <a aria-current={activePath === 'design-system-and-specs' ? 'page' : undefined} class={`font-label-md px-3 py-1.5 transition-colors duration-150 rounded-xl flex items-center gap-1.5 ${activePath === 'design-system-and-specs' ? 'bg-slate-800 text-white border border-cyan-500/20' : 'text-slate-400 hover:text-white hover:bg-slate-800/50'}`} data-path="design-system-and-specs" href="#">
          <span class="material-symbols-outlined text-[16px]">school</span>Beginner Guide
        </a>
      </>
    )}

  </nav>

  <!-- Right Side: Badges & App Drawer Trigger Button -->
  <div class="flex items-center gap-4 text-xs font-mono shrink-0">
    <span class="hidden lg:inline-flex px-2.5 py-1 rounded-md bg-cyan-950/50 text-cyan-400 border border-cyan-500/30 glow-cyan">
      MC 1.21+ PARITY
    </span>
    <span class="text-slate-400 hidden sm:inline">
      <strong class="text-white">{blueprintCount}</strong> INDEXED
    </span>

    <!-- Suite Drawer Trigger Button -->
    <button id="drawer-toggle" class="w-9 h-9 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 border border-white/10 flex items-center justify-center transition-all group cursor-pointer" aria-label="Open Redstone Suite Menu" type="button">
      <span class="material-symbols-outlined text-cyan-400 group-hover:scale-110 transition-transform text-[20px]">apps</span>
    </button>
  </div>

</header>

<!-- SLIDE-OUT SUITE NAVIGATION DRAWER & BACKDROP -->
<div id="suite-drawer-container" class="fixed inset-0 z-[100] pointer-events-none">
  <!-- Backdrop Overlay -->
  <div id="drawer-backdrop" class="absolute inset-0 bg-black/70 backdrop-blur-sm opacity-0 transition-opacity duration-300 pointer-events-none"></div>

  <!-- Slide-out Panel -->
  <aside id="drawer-panel" class="absolute top-0 right-0 h-full w-80 max-w-full bg-[#0F172A] border-l border-white/10 shadow-2xl flex flex-col transform translate-x-full transition-transform duration-300 ease-in-out pointer-events-auto">
    
    <!-- Drawer Header -->
    <div class="p-4 border-b border-white/10 flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <span class="material-symbols-outlined text-cyan-400 text-[22px]">hub</span>
        <div class="flex flex-col">
          <span class="text-sm font-bold tracking-tight text-white uppercase">Redstone Suite</span>
          <span class="text-[10px] font-mono text-slate-400">Project Navigation</span>
        </div>
      </div>
      <button id="drawer-close" class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white flex items-center justify-center transition-colors cursor-pointer" type="button">
        <span class="material-symbols-outlined text-[18px]">close</span>
      </button>
    </div>

    <!-- Drawer Portal Links -->
    <div class="p-4 flex flex-col gap-3 overflow-y-auto flex-1 font-sans">
      <span class="text-[10px] font-mono text-slate-500 uppercase tracking-wider">Available Portals</span>
      
      <!-- Redstone Compendium -->
      <a href="/" class={`group flex items-start gap-3 p-3 rounded-xl border transition-all ${app === 'compendium' ? 'bg-slate-800/90 border-indigo-500/30' : 'bg-slate-900/60 hover:bg-slate-800/80 border-white/5'}`}>
        <div class="w-9 h-9 rounded-lg bg-indigo-950/50 text-indigo-400 border border-indigo-500/20 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
          <span class="material-symbols-outlined text-[18px]">menu_book</span>
        </div>
        <div class="flex flex-col">
          <span class="text-xs font-semibold text-white">Redstone Compendium</span>
          <span class="text-[11px] text-slate-400 mt-0.5 leading-tight">Master reference for mechanics & circuits.</span>
        </div>
      </a>

      <!-- Redstone Academy -->
      <a href="/academy" class={`group flex items-start gap-3 p-3 rounded-xl border transition-all ${app === 'academy' ? 'bg-slate-800/90 border-amber-500/30' : 'bg-slate-900/60 hover:bg-slate-800/80 border-white/5'}`}>
        <div class="w-9 h-9 rounded-lg bg-amber-950/50 text-amber-400 border border-amber-500/20 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
          <span class="material-symbols-outlined text-[18px]">school</span>
        </div>
        <div class="flex flex-col">
          <span class="text-xs font-semibold text-white">Redstone Academy</span>
          <span class="text-[11px] text-slate-400 mt-0.5 leading-tight">Beginner pathways & playgrounds.</span>
        </div>
      </a>

      <!-- Redstone Workshop -->
      <a href="/workshop" class={`group flex items-start gap-3 p-3 rounded-xl border transition-all ${app === 'workshop' ? 'bg-slate-800/90 border-cyan-500/30' : 'bg-slate-900/60 hover:bg-slate-800/80 border-white/5'}`}>
        <div class="w-9 h-9 rounded-lg bg-cyan-950/60 text-cyan-400 border border-cyan-500/30 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
          <span class="material-symbols-outlined text-[18px]">construction</span>
        </div>
        <div class="flex flex-col">
          <span class="text-xs font-semibold text-white">Redstone Workshop</span>
          <span class="text-[11px] text-slate-400 mt-0.5 leading-tight">Sandbox testing & blueprint catalog.</span>
        </div>
      </a>
    </div>

    <!-- Drawer Footer -->
    <div class="p-4 border-t border-white/10 bg-slate-900/40 text-[11px] font-mono text-slate-500 flex items-center justify-between">
      <span>Minecraft 1.21 Parity</span>
      <span class="text-cyan-400">v1.0.0</span>
    </div>

  </aside>
</div>

<!-- SCRIPT FOR DRAWER TOGGLE -->
<script>
  const toggleBtn = document.getElementById('drawer-toggle');
  const closeBtn = document.getElementById('drawer-close');
  const backdrop = document.getElementById('drawer-backdrop');
  const panel = document.getElementById('drawer-panel');
  const container = document.getElementById('suite-drawer-container');

  function openDrawer() {
    container?.classList.remove('pointer-events-none');
    backdrop?.classList.remove('opacity-0', 'pointer-events-none');
    backdrop?.classList.add('opacity-100');
    panel?.classList.remove('translate-x-full');
  }

  function closeDrawer() {
    backdrop?.classList.remove('opacity-100');
    backdrop?.classList.add('opacity-0', 'pointer-events-none');
    panel?.classList.add('translate-x-full');
    setTimeout(() => {
      container?.classList.add('pointer-events-none');
    }, 300);
  }

  toggleBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', closeDrawer);
</script>